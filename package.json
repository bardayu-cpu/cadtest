{
  "name": "cadtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --ignore-pattern 'tmp/**' && prettier --check . --ignore-path .prettierignore --ignore-path scripts/recognize.prettierignore",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && vitest run --config tests/recognize/vitest.config.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "bench:recognize": "node --import tsx scripts/bench-recognize.ts",
    "overlay": "node --import tsx scripts/overlay.ts",
    "smoke:recognize:browser": "node --import tsx scripts/browser-recognize-smoke.ts"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "next": "16.4.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

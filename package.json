{
  "name": "cadtest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "typescript-eslint": "8.55.0",
    "vite": "$vite"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "4.1.11"
  }
}
